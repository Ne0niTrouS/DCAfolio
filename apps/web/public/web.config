<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the built DCAfolio site.

  This file is copied verbatim into dist/ by Vite, so deploying is: build, then
  copy dist/ into the IIS physical path.

  Requires the IIS URL Rewrite module (https://www.iis.net/downloads/microsoft/url-rewrite).
  It is NOT part of a default IIS install; without it IIS returns 500.19 for the
  <rewrite> section below.
-->
<configuration>
  <system.webServer>

    <!--
      Client-side routing: /history and /stocks/CPALL are not files on disk.
      Anything that is not an existing file or directory is served index.html,
      and React Router takes it from there. Without this, a reload or a deep
      link returns 404.
    -->
    <rewrite>
      <rules>
        <rule name="DCAfolio SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>

    <!--
      IIS refuses to serve an extension it has no MIME type for. These are the
      ones a Vite build can emit; `remove` first so the file is valid on a
      server that already defines them.
    -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Nothing here is meant to be framed. -->
        <add name="X-Frame-Options" value="DENY" />
        <!--
          index.html must never be cached: it names the hashed asset files, so a
          stale copy points at bundles that no longer exist. The assets folder
          below opts back in, because those names change on every build.
        -->
        <add name="Cache-Control" value="no-cache, must-revalidate" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!--
    Hashed filenames are safe to cache forever: a changed file gets a new name.
  -->
  <location path="assets">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
