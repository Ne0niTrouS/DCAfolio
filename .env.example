# DCAfolio — browser-safe environment variables only.
# Copy to .env and fill in. NEVER commit .env.
#
# Anything prefixed with VITE_ is embedded in the public browser bundle.
# NEVER put the Supabase service-role key or any other secret here.
# Server secrets belong in Supabase Edge Function secrets (supabase secrets set).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Market data provider id used by the web client.
# 'mock' is the documented default until a free provider is verified.
VITE_MARKET_DATA_PROVIDER=mock
