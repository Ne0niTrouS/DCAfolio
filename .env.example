# DCAfolio — browser-safe environment variables only.
# Copy to .env and fill in. NEVER commit .env.
#
# Anything prefixed with VITE_ is embedded in the public browser bundle.
# NEVER put the Supabase service-role key or any other secret here.
# Server secrets belong in Supabase Edge Function secrets (supabase secrets set).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Market data provider id, mirrored from the MARKET_DATA_PROVIDER Edge Function
# secret. The browser never calls a real provider itself; this tells it which
# provider the server is using, so it knows not to resolve one locally.
# 'yahoo' for real SET prices, 'mock' for obviously synthetic ones.
VITE_MARKET_DATA_PROVIDER=yahoo
